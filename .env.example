# Local Vinext sign-in is restricted to loopback. Hosted private ingress must inject trusted identity.
APP_ORIGIN=http://localhost:5173
# Use a stable private owner ID on Vercel or the owner's dispatcher ID on Sites.
OWNER_USER_ID=
# Vercel / native Next.js only. Set APP_ORIGIN above to the exact HTTPS origin.
# Generate SIGNALDESK_OWNER_KEY from 32 random bytes encoded as 64 hex characters.
SIGNALDESK_OWNER_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional. Connecting a private Vercel Blob store supplies this token.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_APP_NAME=SignalDesk
# Register APP_ORIGIN/api/x/callback with X.
X_CLIENT_ID=
X_CLIENT_SECRET=
# A 32-byte AES key, encoded as 64 hex characters.
X_TOKEN_ENCRYPTION_KEY=
# Run the separate queue worker with the same random secret as the web process.
SIGNALDESK_WORKER_SECRET=
# Set a conservative allowance only after verifying your deletion rate.
X_DELETE_COST_MICROS=
# Optional first-party campaign event ingestion. Separate random secret of 32+ bytes.
SIGNALDESK_EVENT_SECRET=
# Server-provisioned operator identity to which signed site events belong.
SIGNALDESK_EVENT_OWNER=
# Optional scoped developer token for the local MCP process. Never expose it to the browser.
SIGNALDESK_API_TOKEN=
# Optional verified developer app owner's X user ID (discount qualification).
X_DEVELOPER_OWNER_ID=
X_DELETE_BATCH_LIMIT=3
# Optional locally installed Ollama model. The app sends only selected drafting context.
OLLAMA_MODEL=
