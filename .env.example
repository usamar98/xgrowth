# Set these as secret runtime values for hosted Sites; never commit real values.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_TOKEN_ENCRYPTION_KEY=
APP_ORIGIN=https://xgrowth-content-studio.salmanonchain.chatgpt.site
# X_TOKEN_ENCRYPTION_KEY: 32 random bytes encoded as 64 hexadecimal characters.
# Local preview uses APP_ORIGIN=http://localhost:5173 and the matching callback.
# Register APP_ORIGIN/api/x/callback exactly in your X app's OAuth 2.0 settings.
